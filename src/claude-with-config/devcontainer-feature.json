{
    "id": "claude-with-config",
    "version": "1.1.0",
    "name": "Claude Code with Config",
    "description": "Configures Claude Code with host-side configuration for seamless authentication. Depends on the official Claude Code Feature.",
    "documentationURL": "https://github.com/Walkmana-25/devcontainer-features/tree/main/src/claude-with-config",
    "options": {},
    "dependsOn": {
        "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
    },
    "mounts": [
        {
            "source": "${localEnv:HOME}/.claude",
            "target": "/claude_config",
            "type": "bind"
        }
    ],
    "postCreateCommand": "if [ ! -e \"~/.claude\" ]; then ln -s /claude_config \"~/.claude\"; fi"
}
