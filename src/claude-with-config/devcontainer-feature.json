{
    "id": "claude-with-config",
    "version": "1.0.0",
    "name": "Claude Code with Config",
    "description": "Configures Claude Code with host-side configuration for seamless authentication. Depends on the official Claude Code Feature.",
    "documentationURL": "https://github.com/anthropics/devcontainer-features/tree/main/src/claude-code",
    "options": {},
    "dependsOn": {
        "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
    },
    "mounts": [
        {
            "source": "${localEnv:HOME}/.claude",
            "target": "${_REMOTE_USER_HOME}/.claude",
            "type": "bind"
        }
    ]
}
